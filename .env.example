# Supabase PostgreSQL Connection String (Session or Transaction Pooler URI)
# Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres.drladbxpfnapxjmoxqhj:[YOUR-DB-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres

# Secret for signing login session tokens (generate a random 64-char hex string)
AUTH_SECRET=replace-with-a-random-64-char-hex-secret

# Optional: Auto-create the first Head Office Admin on initial boot (otherwise set up in browser UI)
# ADMIN_NAME=Head Office Admin
# ADMIN_PHONE=admin
# ADMIN_PIN=1234

PORT=3001
